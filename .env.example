# ---- Backend (read by backend/app/core/config.py) ----------------------------
# Maximum upload size in megabytes. Reported to the frontend via /health.
MAX_UPLOAD_MB=10
# Reject images with more pixels than this before decoding (decompression-bomb guard).
MAX_IMAGE_PIXELS=40000000
# Comma-separated allowed file extensions.
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
# Comma-separated list of browser origins allowed to call the API. In
# production set this to the deployed frontend origin only, e.g. https://plates.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OCR language setting reported by the API (the bundled RapidOCR model reads Chinese and English).
OCR_LANGUAGE=en
# How many ranked candidate regions are passed to OCR (1 to 8).
OCR_CANDIDATES=3
# Detection runs on a copy whose longest side is at most this many pixels.
DETECTOR_MAX_SIDE=960
# SVM plate verification (HOG + linear SVM). Active only when backend/models/plate_svm.npz exists;
# otherwise the API runs without it and /health reports svm: no_model.
ENABLE_SVM=true
# Optional: absolute path of a different model file (empty = backend/models/plate_svm.npz).
SVM_MODEL_PATH=
# Optional: regions with an SVM margin below this are rejected in "svm" detector mode.
# Empty = the threshold stored with the model (see models/plate_svm.json).
SVM_MIN_MARGIN=
# SVM character recognition (second OCR engine). Active only when backend/models/ocr_svm.npz exists.
ENABLE_SVM_OCR=true
# Optional: absolute path of a different model file (empty = backend/models/ocr_svm.npz).
SVM_OCR_MODEL_PATH=
# MATLAB bridge. On by default but inert unless MATLAB and the matlabengine Python package are
# installed on the backend host; otherwise OpenCV runs every filter. Set false to never start MATLAB.
ENABLE_MATLAB=true
# Optional: absolute path of the repository's matlab/ folder (auto-detected when empty).
MATLAB_PATH=

# ---- Frontend (copy frontend/.env.example to frontend/.env.local) -------------
# VITE_API_BASE_URL=http://127.0.0.1:8000
